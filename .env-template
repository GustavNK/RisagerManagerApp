# =============================================================================
# Risager Application Configuration Template
# =============================================================================
# Copy this file to .env and update with your actual values:
#   cp .env-template .env
#
# WARNING: Never commit the .env file to version control!
# =============================================================================

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Environment: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Production

# Port Configuration (external ports exposed to host)
FRONTEND_PORT=3000
BACKEND_PORT=5062

# API URL for frontend to connect to backend (used at build time)
# For local Docker: http://localhost:5062
# For production: https://your-domain.com or http://your-server-ip:5062
NEXT_PUBLIC_API_URL=http://localhost:5062

# =============================================================================
# POSTGRESQL DATABASE
# =============================================================================
# Database credentials - CHANGE THESE IN PRODUCTION!
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=risager
POSTGRES_PORT=5432

# =============================================================================
# MINIO OBJECT STORAGE (S3-compatible)
# =============================================================================
# MinIO credentials - CHANGE THESE IN PRODUCTION!
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_secret_key
MINIO_BUCKET_NAME=risager
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# =============================================================================
# ADMIN USER SEEDING
# =============================================================================
# Initial admin account created on first startup
# CHANGE THESE IN PRODUCTION!
ADMIN_EMAIL=admin@risager.dk
ADMIN_PASSWORD=CHANGE_ME_admin_password
ADMIN_FIRST_NAME=Administrator
ADMIN_LAST_NAME=User

# =============================================================================
# OPTIONAL: AZURE BLOB STORAGE (Alternative to MinIO)
# =============================================================================
# Uncomment and configure if using Azure Blob Storage instead of MinIO
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER_NAME=risager

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. Generate strong passwords using: openssl rand -base64 32
# 2. Each environment (dev, staging, prod) should have unique credentials
# 3. Consider using Docker secrets or a secrets manager for production
# 4. Rotate credentials periodically
# 5. Never share or commit credentials
#
# Password requirements for admin account:
# - Minimum 3 characters (relaxed for development)
# - For production, use at least 16 characters with mixed case, numbers, symbols
# =============================================================================
